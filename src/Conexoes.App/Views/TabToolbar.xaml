<UserControl x:Class="Conexoes.App.Views.TabToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- DataContext: um ListTabViewModel<T>. Filtros extras entram em ExtraContent. -->
    <StackPanel Margin="0,0,0,6">
        <WrapPanel>
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="260" VerticalContentAlignment="Center" Padding="3"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="Filtra por qualquer texto da linha (nome, caminho, IP, usuário...)" />
            <CheckBox Content="Só com alerta" IsChecked="{Binding OnlyRisk}" Margin="12,0,14,0" />
            <ContentPresenter Content="{Binding ExtraContent, ElementName=Root}" VerticalAlignment="Center" />
            <Button Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}" />
            <ProgressBar IsIndeterminate="True" Width="80" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
        </WrapPanel>
        <TextBlock Text="{Binding Error}" Foreground="#B00020" Margin="0,4,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
