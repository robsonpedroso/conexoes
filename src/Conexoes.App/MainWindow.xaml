<Window x:Class="Conexoes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Conexoes.App.Views"
        xmlns:vm="clr-namespace:Conexoes.App.ViewModels"
        Title="Conexões · Inspetor de segurança local" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F7F8FA"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Detalhes..." Click="Details_Click" />
            <MenuItem Header="Abrir local do arquivo" Click="OpenLocation_Click" />
            <MenuItem Header="Copiar caminho" Click="CopyPath_Click" />
            <MenuItem Header="Copiar linhas selecionadas" Click="CopyRows_Click" />
            <Separator />
            <MenuItem Header="Finalizar processo..." Click="KillProcess_Click" />
        </ContextMenu>
        <ContextMenu x:Key="StartupMenu" x:Shared="False">
            <MenuItem Header="Abrir local da inicialização" Click="OpenStartupLocation_Click" FontWeight="SemiBold" />
            <Separator />
            <MenuItem Header="Detalhes..." Click="Details_Click" />
            <MenuItem Header="Abrir local do arquivo" Click="OpenLocation_Click" />
            <MenuItem Header="Copiar caminho" Click="CopyPath_Click" />
            <MenuItem Header="Copiar linhas selecionadas" Click="CopyRows_Click" />
            <Separator />
            <MenuItem Header="Finalizar processo..." Click="KillProcess_Click" />
        </ContextMenu>
        <ContextMenu x:Key="TaskMenu" x:Shared="False">
            <MenuItem Header="Abrir no Agendador de Tarefas (copia o caminho)" Click="OpenTaskScheduler_Click" FontWeight="SemiBold"
                      ToolTip="O Agendador não abre direto numa tarefa: o caminho dela vai para a área de transferência para localizar na árvore." />
            <Separator />
            <MenuItem Header="Detalhes..." Click="Details_Click" />
            <MenuItem Header="Abrir local do arquivo" Click="OpenLocation_Click" />
            <MenuItem Header="Copiar caminho" Click="CopyPath_Click" />
            <MenuItem Header="Copiar linhas selecionadas" Click="CopyRows_Click" />
            <Separator />
            <MenuItem Header="Finalizar processo..." Click="KillProcess_Click" />
        </ContextMenu>
        <ContextMenu x:Key="AlertMenu" x:Shared="False">
            <MenuItem Header="Ir para a aba correspondente" Click="GoToTab_Click" FontWeight="SemiBold" />
            <Separator />
            <MenuItem Header="Detalhes..." Click="Details_Click" />
            <MenuItem Header="Copiar linhas selecionadas" Click="CopyRows_Click" />
        </ContextMenu>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
            <Setter Property="RowStyle" Value="{StaticResource RiskRowStyle}" />
            <EventSetter Event="MouseDoubleClick" Handler="Grid_DoubleClick" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Cabeçalho -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Analisar tudo" Command="{Binding AnalyzeAllCommand}" Style="{StaticResource ToolbarButton}" FontWeight="SemiBold" />
                    <Button Content="Exportar aba (CSV)" Click="ExportCsv_Click" Style="{StaticResource ToolbarButton}" />
                    <Button Content="Relatório completo (HTML)" Click="ExportHtml_Click" Style="{StaticResource ToolbarButton}" Margin="0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Conexões" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Foreground="#DCE6F5" FontSize="12">
                        <Run Text="Computador:" /> <Run Text="{Binding MachineName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  ·  Usuário:" /> <Run Text="{Binding CurrentUser, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Aviso quando não está elevado -->
        <Border DockPanel.Dock="Top" Background="#FFF4CE" Padding="14,6" BorderBrush="#E0C060" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="O programa não está rodando como administrador: caminhos de processos do sistema, sessões e algumas tarefas podem não aparecer." TextWrapping="Wrap" />
        </Border>

        <!-- Barra de status -->
        <StatusBar DockPanel.Dock="Bottom" Background="#EEF0F3">
            <StatusBarItem>
                <TextBlock Text="{Binding LastAnalysis}" />
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar IsIndeterminate="True" Width="120" Height="10"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="{StaticResource MutedBrush}"
                           Text="Linhas: vermelho = alto · laranja = médio · amarelo = baixo. Clique com o botão direito para ações; duplo clique para detalhes." />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="8" Padding="8">
            <!-- ===================== RESUMO ===================== -->
            <TabItem Header="Resumo" Tag="Resumo">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding ExternalConnectionCount}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="conexões externas" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding ExternalProgramCount}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="programas com conexão externa" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding SessionCount}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="sessões conectadas" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding ActiveAdminCount}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="administradores ativos" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding NonMicrosoftTaskCount}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="tarefas agendadas (não Microsoft)" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding StartupCount}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="itens de inicialização" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Background="{StaticResource HighBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding HighAlerts}" Foreground="#A50E0E" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="alertas altos" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Background="{StaticResource MediumBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding MediumAlerts}" Foreground="#8A5300" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="alertas médios" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Background="{StaticResource LowBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardValue}" Text="{Binding LowAlerts}" />
                                <TextBlock Style="{StaticResource CardLabel}" Text="alertas baixos" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Grid.Row="1" Style="{StaticResource SectionTitle}" Text="Programas fazendo conexões externas" />
                    <DataGrid Grid.Row="2" x:Name="GridExternalPrograms" ItemsSource="{Binding ExternalPrograms}" Tag="Programas com conexões externas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="60" />
                            <DataGridTextColumn Header="Programa" Binding="{Binding ProcessName}" Width="170" />
                            <DataGridTextColumn Header="PID(s)" Binding="{Binding Pids}" Width="90" />
                            <DataGridTextColumn Header="Conexões" Binding="{Binding Connections}" Width="70" />
                            <DataGridTextColumn Header="IPs remotos" Binding="{Binding RemoteAddresses}" Width="80" />
                            <DataGridTextColumn Header="Hosts" Binding="{Binding RemoteHosts}" Width="260" />
                            <DataGridTextColumn Header="Assinatura" Binding="{Binding Signature}" Width="110" />
                            <DataGridTextColumn Header="Publicador" Binding="{Binding Publisher}" Width="180" />
                            <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Style="{StaticResource SectionTitle}" Text="Alertas (heurísticos: indicam o que vale conferir, não confirmam malware)" />
                    <DataGrid Grid.Row="4" x:Name="GridAlerts" ItemsSource="{Binding Alerts}" Tag="Alertas"
                              RowStyle="{StaticResource AlertRowStyle}" ContextMenu="{StaticResource AlertMenu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nível" Binding="{Binding LevelLabel}" Width="60" />
                            <DataGridTextColumn Header="Origem" Binding="{Binding Category}" Width="120" />
                            <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="420" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== CONEXÕES ===================== -->
            <TabItem Header="Conexões" DataContext="{Binding Connections}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top">
                        <v:TabToolbar.ExtraContent>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Só externas" IsChecked="{Binding OnlyExternal}" ToolTip="Oculta loopback, rede local e portas em escuta (exceto as com alerta)" />
                                <CheckBox Content="Só estabelecidas" IsChecked="{Binding OnlyEstablished}" />
                                <CheckBox Content="Ocultar UDP" IsChecked="{Binding HideUdp}" />
                                <CheckBox Content="DNS reverso" IsChecked="{Binding ResolveDns}" ToolTip="Consulta o nome de cada IP externo no servidor DNS configurado" />
                                <CheckBox Content="Atualizar a cada" IsChecked="{Binding AutoRefresh}" Margin="0,0,4,0" />
                                <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding IntervalSeconds}" Width="50" VerticalAlignment="Center" />
                                <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,14,0" />
                            </StackPanel>
                        </v:TabToolbar.ExtraContent>
                    </v:TabToolbar>
                    <DataGrid x:Name="GridConnections" ItemsSource="{Binding View}" Tag="Conexões">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Processo" Binding="{Binding ProcessName}" Width="150" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                            <DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="65" />
                            <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="150" />
                            <DataGridTextColumn Header="Remoto" Binding="{Binding Remote}" Width="170" />
                            <DataGridTextColumn Header="Host remoto" Binding="{Binding RemoteHost}" Width="220" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="95" />
                            <DataGridTextColumn Header="Escopo" Binding="{Binding ScopeLabel}" Width="70" />
                            <DataGridTextColumn Header="Assinatura" Binding="{Binding SignatureLabel}" Width="100" />
                            <DataGridTextColumn Header="Publicador" Binding="{Binding Publisher}" Width="170" />
                            <DataGridTextColumn Header="Caminho" Binding="{Binding ProcessPath}" Width="300" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== PROCESSOS ===================== -->
            <TabItem Header="Processos" DataContext="{Binding Processes}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top" />
                    <DataGrid x:Name="GridProcesses" ItemsSource="{Binding View}" Tag="Processos">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="PID pai" Binding="{Binding ParentPid}" Width="60" />
                            <DataGridTextColumn Header="Processo pai" Binding="{Binding ParentName}" Width="140" />
                            <DataGridTextColumn Header="Usuário" Binding="{Binding User}" Width="170" />
                            <DataGridTextColumn Header="Conexões" Binding="{Binding Connections}" Width="65" />
                            <DataGridTextColumn Header="Externas" Binding="{Binding ExternalConnections}" Width="60" />
                            <DataGridTextColumn Header="Assinatura" Binding="{Binding SignatureLabel}" Width="100" />
                            <DataGridTextColumn Header="Publicador" Binding="{Binding Publisher}" Width="170" />
                            <DataGridTextColumn Header="Início" Binding="{Binding StartTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="125" />
                            <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="280" />
                            <DataGridTextColumn Header="Linha de comando" Binding="{Binding CommandLine}" Width="350" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="280" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== SESSÕES ===================== -->
            <TabItem Header="Sessões" DataContext="{Binding Sessions}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top" />
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Quem está conectado: sessões locais (console), área de trabalho remota (RDP) e acessos a compartilhamentos pela rede (SMB)." />
                    <DataGrid x:Name="GridSessions" ItemsSource="{Binding View}" Tag="Sessões">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="70" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" />
                            <DataGridTextColumn Header="Usuário" Binding="{Binding User}" Width="200" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="100" />
                            <DataGridTextColumn Header="Estação" Binding="{Binding Station}" Width="110" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClientName}" Width="140" />
                            <DataGridTextColumn Header="Endereço do cliente" Binding="{Binding ClientAddress}" Width="140" />
                            <DataGridTextColumn Header="Logon" Binding="{Binding LogonTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="130" />
                            <DataGridTextColumn Header="Ocioso" Binding="{Binding IdleLabel}" Width="70" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== USUÁRIOS ===================== -->
            <TabItem Header="Usuários" DataContext="{Binding Users}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top" />
                    <DataGrid x:Name="GridUsers" ItemsSource="{Binding View}" Tag="Usuários locais">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Conta" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="Nome completo" Binding="{Binding FullName}" Width="150" />
                            <DataGridTextColumn Header="Ativa" Binding="{Binding EnabledLabel}" Width="50" />
                            <DataGridTextColumn Header="Administrador" Binding="{Binding AdminLabel}" Width="90" />
                            <DataGridTextColumn Header="Último logon" Binding="{Binding LastLogon, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="120" />
                            <DataGridTextColumn Header="Senha alterada" Binding="{Binding PasswordLastSet, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="120" />
                            <DataGridCheckBoxColumn Header="Senha nunca expira" Binding="{Binding PasswordNeverExpires}" Width="115" />
                            <DataGridCheckBoxColumn Header="Senha não exigida" Binding="{Binding PasswordNotRequired}" Width="110" />
                            <DataGridCheckBoxColumn Header="Bloqueada" Binding="{Binding LockedOut}" Width="70" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="250" />
                            <DataGridTextColumn Header="SID" Binding="{Binding Sid}" Width="290" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== ADMINISTRADORES ===================== -->
            <TabItem Header="Administradores" DataContext="{Binding Admins}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top" />
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Membros do grupo Administradores (SID S-1-5-32-544), equivalente a 'net localgroup Administradores'." />
                    <DataGrid x:Name="GridAdmins" ItemsSource="{Binding View}" Tag="Administradores">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Membro" Binding="{Binding Name}" Width="260" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="110" />
                            <DataGridTextColumn Header="Origem" Binding="{Binding LocalLabel}" Width="130" />
                            <DataGridTextColumn Header="Ativa" Binding="{Binding EnabledLabel}" Width="50" />
                            <DataGridTextColumn Header="SID" Binding="{Binding Sid}" Width="300" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== TAREFAS ===================== -->
            <TabItem Header="Tarefas agendadas" DataContext="{Binding Tasks}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top">
                        <v:TabToolbar.ExtraContent>
                            <CheckBox Content="Ocultar tarefas da Microsoft" IsChecked="{Binding HideMicrosoft}"
                                      ToolTip="Oculta a pasta \Microsoft\ (as que têm alerta continuam visíveis)" />
                        </v:TabToolbar.ExtraContent>
                    </v:TabToolbar>
                    <DataGrid x:Name="GridTasks" ItemsSource="{Binding View}" Tag="Tarefas agendadas"
                              ContextMenu="{StaticResource TaskMenu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="220" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="80" />
                            <DataGridTextColumn Header="Executa como" Binding="{Binding RunAs}" Width="110" />
                            <DataGridTextColumn Header="Privilégio" Binding="{Binding PrivilegeLabel}" Width="65" />
                            <DataGridTextColumn Header="Gatilhos" Binding="{Binding Triggers}" Width="140" />
                            <DataGridTextColumn Header="Ações" Binding="{Binding Actions}" Width="320" />
                            <DataGridTextColumn Header="Última execução" Binding="{Binding LastRun, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="115" />
                            <DataGridTextColumn Header="Resultado" Binding="{Binding LastResult}" Width="80" />
                            <DataGridTextColumn Header="Próxima" Binding="{Binding NextRun, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="115" />
                            <DataGridTextColumn Header="Assinatura" Binding="{Binding SignatureLabel}" Width="100" />
                            <DataGridTextColumn Header="Publicador" Binding="{Binding Publisher}" Width="160" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="140" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== INICIALIZAÇÃO ===================== -->
            <TabItem Header="Inicialização" DataContext="{Binding Startup}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top" />
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Programas que iniciam com o Windows: chaves Run/RunOnce (HKLM/HKCU), pastas Inicializar e Winlogon. HKCU mostra apenas o usuário atual." />
                    <DataGrid x:Name="GridStartup" ItemsSource="{Binding View}" Tag="Inicialização"
                              ContextMenu="{StaticResource StartupMenu}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Local" Binding="{Binding Location}" Width="230" />
                            <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="420" />
                            <DataGridTextColumn Header="Assinatura" Binding="{Binding SignatureLabel}" Width="110" />
                            <DataGridTextColumn Header="Publicador" Binding="{Binding Publisher}" Width="170" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== SERVIÇOS ===================== -->
            <TabItem Header="Serviços" DataContext="{Binding Services}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top">
                        <v:TabToolbar.ExtraContent>
                            <CheckBox Content="Ocultar serviços da Microsoft" IsChecked="{Binding HideMicrosoft}"
                                      ToolTip="Oculta serviços assinados pela Microsoft (os que têm alerta continuam visíveis)" />
                        </v:TabToolbar.ExtraContent>
                    </v:TabToolbar>
                    <DataGrid x:Name="GridServices" ItemsSource="{Binding View}" Tag="Serviços">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="170" />
                            <DataGridTextColumn Header="Nome de exibição" Binding="{Binding DisplayNameText}" Width="220" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="90" />
                            <DataGridTextColumn Header="Inicialização" Binding="{Binding StartMode}" Width="90" />
                            <DataGridTextColumn Header="Conta" Binding="{Binding Account}" Width="160" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="55" />
                            <DataGridTextColumn Header="Assinatura" Binding="{Binding SignatureLabel}" Width="100" />
                            <DataGridTextColumn Header="Publicador" Binding="{Binding Publisher}" Width="170" />
                            <DataGridTextColumn Header="Caminho" Binding="{Binding PathName}" Width="380" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===================== COMPARTILHAMENTOS ===================== -->
            <TabItem Header="Compartilhamentos" DataContext="{Binding Shares}">
                <DockPanel>
                    <v:TabToolbar DockPanel.Dock="Top" />
                    <DataGrid x:Name="GridShares" ItemsSource="{Binding View}" Tag="Compartilhamentos">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Risco" Binding="{Binding RiskLabel}" Width="55" />
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="300" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="150" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="250" />
                            <DataGridTextColumn Header="Motivo do alerta" Binding="{Binding RiskText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
